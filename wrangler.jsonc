{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketpic",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "pocketpic"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
