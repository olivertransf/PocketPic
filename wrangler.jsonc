{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketpic",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "pocketpic",
      // Use the real bucket during `wrangler dev`, so local development sees the
      // same photos the deployed site does. Ignored on deploy.
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
